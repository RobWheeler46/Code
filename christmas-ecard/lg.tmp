const fs=require('fs');
function edit(f,pairs){let s=fs.readFileSync(f,'utf8');for(const [a,b] of pairs){if(!s.includes(a))throw new Error(f+' missing: '+a.slice(0,60));s=s.replace(a,()=>b)}fs.writeFileSync(f,s)}
edit('src/core.php',[["<div style=\"background:#024593;color:#fff;padding:16px 20px;font-size:18px;font-weight:bold;border-bottom:4px solid #f5b800\">7th Swindon Scouts Christmas Cards</div>","<div style=\"background:#024593;color:#fff;padding:12px 20px;border-bottom:4px solid #f5b800\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><img src=\"' . $e(base_url() . '/assets/brand/7th-swindon-circle-blue.png') . '\" alt=\"7th Swindon Scouts\" width=\"56\" height=\"56\" style=\"display:block;border-radius:28px\"></td><td style=\"padding-left:14px;color:#ffffff;font-size:18px;font-weight:bold\">Christmas Cards</td></tr></table></div>"]]);
edit('src/lib.php',[["<footer><a href=\"/privacy\">","<footer><img class=\"footlogo\" src=\"/assets/brand/7th-swindon-circle-blue.png\" alt=\"7th Swindon Scouts\" width=\"56\" height=\"56\"><a href=\"/privacy\">"]]);
fs.writeFileSync('public/assets/style.css',fs.readFileSync('public/assets/style.css','utf8')+".footlogo{display:block;margin:0 auto .8rem;height:3.5rem;width:3.5rem;border-radius:50%;box-shadow:0 0 0 2px rgba(255,255,255,.5)}\n");
