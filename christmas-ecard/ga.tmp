const fs=require('fs');
function edit(f,pairs){let s=fs.readFileSync(f,'utf8');for(const [a,b] of pairs){if(!s.includes(a))throw new Error(f+' missing: '+a.slice(0,70));s=s.replace(a,()=>b)}fs.writeFileSync(f,s)}
