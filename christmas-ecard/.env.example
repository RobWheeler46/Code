APP_URL=http://localhost:8060
# development, staging or production. Anything but production shows a test banner; production locks sending until launch decisions are approved.
APP_ENV=development
MAIL_FROM=cards@7thswindon.org.uk
SUPPORT_EMAIL=cards@7thswindon.org.uk
# Leave blank for local dev: mail goes to data/outbox.log, payment is simulated
POSTMARK_TOKEN=
POSTMARK_HOOK_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Connected 7th Swindon account (acct_...)
STRIPE_ACCOUNT=
# Backups (spec FR-162). BACKUP_KEY encrypts them; set at least one off-server route.
BACKUP_KEY=
# A folder outside this server (for example a synced or mounted folder)
BACKUP_COPY_DIR=
# Or email the encrypted file to a mailbox (needs POSTMARK_TOKEN)
BACKUP_EMAIL=

# eCard Library tables (build pack v2.7, EC-01). Leave on. Set to off only after running: php src/cli.php library-rollback
LIBRARY_MIGRATE=on
