APP_URL=http://localhost:8060
# development, staging or production. Anything but production shows a test banner; production locks sending until launch decisions are approved.
# development shows a test banner and never locks sending. Set production for the live service (a missing line counts as production).
APP_ENV=development
MAIL_FROM=cards@7thswindon.org.uk
SUPPORT_EMAIL=cards@7thswindon.org.uk
# Leave blank for local dev: mail goes to data/outbox.log, payment is simulated
POSTMARK_TOKEN=
POSTMARK_HOOK_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Connected 7th Swindon account (acct_...)
STRIPE_ACCOUNT=
# Backups (spec FR-162). BACKUP_KEY encrypts them; set at least one off-server route.
BACKUP_KEY=
# A folder outside this server (for example a synced or mounted folder)
BACKUP_COPY_DIR=
# Or email the encrypted file to a mailbox (needs POSTMARK_TOKEN)
BACKUP_EMAIL=

# eCard Library tables (build pack v2.7, EC-01). Leave on. Set to off only after running: php src/cli.php library-rollback
LIBRARY_MIGRATE=on

# First time set up: the person who registers and confirms this address becomes the first restricted administrator.
# Works only while there is no restricted administrator. Remove it afterwards if you like.
ADMIN_EMAIL=

# Send through the Group's own mail account instead of Postmark (used only while POSTMARK_TOKEN is empty).
# SMTP gives no bounce or delivery feedback. SMTP_SECURE is tls (port 587, the usual), ssl (port 465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# How many emails to send each time the queue runs (every 5 minutes). Keep it under your host's hourly limit.
SMTP_PER_RUN=20

