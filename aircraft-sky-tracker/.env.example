# Local Aircraft Sky Tracker - environment configuration
# Copy to .env and adjust as required. All values below are the defaults.

NODE_ENV=production
HTTP_PORT=3000
DATABASE_PATH=./data/tracker.sqlite

# Aircraft data source: adsbfi | airplaneslive | simulation
# NOTE: airplanes.live restricted its public REST API to HTTP 403 for general
# clients after this spec was written. adsb.fi serves the same open ADS-B data
# in the same format and is the working default.
AIRCRAFT_PROVIDER=adsbfi
AIRCRAFT_POLL_INTERVAL_MS=1100

# Optional password for changing configuration (FRD §79). Viewing the display
# is ALWAYS open; when SITE_PASSWORD is set, only changing config and viewing
# diagnostics require it. Leave unset for a fully open LAN/kiosk deployment.
# The username is ignored - only the password is checked.
# SITE_PASSWORD=

DEFAULT_POSTCODE=SN25 4TP
DEFAULT_RADIUS_MILES=10

# Route (destination) enrichment provider: adsbdb
ROUTE_PROVIDER=adsbdb

# Optional Airframes operational flight-intelligence provider (FRD v3.8 §21-26).
# Adds OOOI events, flight state, ETA and stronger route corroboration. Credentials
# stay server-side; disabled unless AIRFRAMES_ENABLED=true AND a key is set. The
# live REST mapping awaits confirmed API access - the simulation aircraft provider
# exercises the whole pipeline meanwhile (§106).
# AIRFRAMES_ENABLED=false
# AIRFRAMES_MODE=rest
# AIRFRAMES_API_KEY=
# AIRFRAMES_URL=https://api.airframes.io/v1

# Live ACARS/VDL2 message display (FRD v3.9). The feature is off by default and
# decoded-only when a user enables it. Exposing the ORIGINAL raw message payload
# is a DEPLOYMENT-level decision that a user preference can never override: it is
# permitted only where BOTH this flag is true AND the user selects "full". Because
# rules on radio-message interception/disclosure vary by jurisdiction, this stays
# false unless the deployment is explicitly permitted to show raw payloads.
# ALLOW_RAW_ACARS_DISPLAY=false

# Live ACARS uses Airframes' keyless public /v1/messages feed by default (it only
# fetches when a user enables ACARS display). Set false to disable the live fetch
# (simulation still works). An AIRFRAMES_API_KEY (above) raises the rate limit.
# ACARS_LIVE_ENABLED=true

LOG_LEVEL=info

# Push alerts for interesting aircraft (FRD Phase 3) via ntfy.sh. Push is OFF
# unless a topic is set. Pick a hard-to-guess topic and subscribe to it in the
# ntfy app (https://ntfy.sh) on your phone.
# NOTIFY_NTFY_TOPIC=
# NOTIFY_NTFY_SERVER=https://ntfy.sh

# Optional Space-Track.org backup for satellite orbital data. CelesTrak is the
# primary source; if it is unreachable the app falls back to Space-Track (the
# authoritative origin of the data). Create a free account at
# https://www.space-track.org and set both below to enable the backup. Disabled
# unless both are set. Credentials stay server-side.
# SPACETRACK_USER=
# SPACETRACK_PASSWORD=

# Optional Google Sign-In for personal saved locations (FRD v3.6 §12, §26).
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud console,
# add your app's origin, and add the redirect URI:
#   https://<your-domain>/api/auth/google/callback  (and http://localhost:3000/...
#   for local dev). Sign-in is disabled unless both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Secret used to sign session cookies (any long random string); a stable value
# keeps users signed in across restarts. Falls back to SITE_PASSWORD if unset.
# SESSION_SECRET=

# Restrict browser Host/Origin values (comma separated) for LAN deployments.
# Leave blank to allow any host (single-user local network default).
# ALLOWED_HOSTS=localhost:3000,raspberrypi.local:3000

# Future: local ADS-B receiver feed (readsb / dump1090 aircraft.json)
# LOCAL_ADSB_URL=http://localhost:8080/data/aircraft.json
