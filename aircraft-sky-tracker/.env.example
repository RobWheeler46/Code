# Local Aircraft Sky Tracker - environment configuration
# Copy to .env and adjust as required. All values below are the defaults.

NODE_ENV=production
HTTP_PORT=3000
DATABASE_PATH=./data/tracker.sqlite

# Aircraft data source: adsbfi | airplaneslive | simulation
# NOTE: airplanes.live restricted its public REST API to HTTP 403 for general
# clients after this spec was written. adsb.fi serves the same open ADS-B data
# in the same format and is the working default.
AIRCRAFT_PROVIDER=adsbfi
AIRCRAFT_POLL_INTERVAL_MS=1100

# Optional HTTP Basic Auth for internet-facing deployments (FRD §79).
# Leave SITE_PASSWORD unset for open LAN/kiosk use. When set, the whole app
# (except /api/health) requires these credentials.
# SITE_USERNAME=tracker
# SITE_PASSWORD=

DEFAULT_POSTCODE=SN25 4TP
DEFAULT_RADIUS_MILES=10

# Route (destination) enrichment provider: adsbdb
ROUTE_PROVIDER=adsbdb

LOG_LEVEL=info

# Restrict browser Host/Origin values (comma separated) for LAN deployments.
# Leave blank to allow any host (single-user local network default).
# ALLOWED_HOSTS=localhost:3000,raspberrypi.local:3000

# Future: local ADS-B receiver feed (readsb / dump1090 aircraft.json)
# LOCAL_ADSB_URL=http://localhost:8080/data/aircraft.json
